# G0DM0D3 — Self-hosted API Quickstart
# Copy this file to .env and fill in your keys before starting the containers.

# ─── REQUIRED ───────────────────────────────────────────────────────────────
# OpenRouter key. Every model call uses this on the server side, so your users
# / coding agents never need to pass a provider key themselves.
OPENROUTER_API_KEY=sk-or-...

# ─── AUTHENTICATION (recommended for any non-local use) ─────────────────────
# Comma-separated or single key. If unset, anyone who can reach the port can
# call the API — fine for local dev, unsuitable for a shared host.
GODMODE_API_KEY=sk-my-self-hosted-secret

# Optional: multiple keys with tier assignments
# GODMODE_API_KEYS=sk-friend-one,sk-friend-two
# GODMODE_TIER_KEYS="enterprise:sk-friend-one,pro:sk-friend-two"

# ─── OPERATION ──────────────────────────────────────────────────────────────
# Port override (default matches HF Spaces convention)
# PORT=7860

# CORS origin (default: production frontend)
# Set to * to allow any origin when the API is behind a firewall/VPN.
CORS_ORIGIN=https://godmod3.ai

# ─── OPTIONAL — auto-publish the opt-in dataset to HuggingFace ──────────────
# HF_TOKEN=hf_your_token
# HF_DATASET_REPO=pliny-the-prompter/g0dm0d3

# Web UI port (compose only)
WEB_PORT=3000
